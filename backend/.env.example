# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Auth
SESSION_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Database (SQLite by default for zero-config local dev; swap to Postgres in production)
DATABASE_URL="file:./dev.db"
# Example Postgres URL if you switch providers in schema.prisma:
# DATABASE_URL="postgresql://user:password@localhost:5432/calmcampus"

# AI Service (optional — the app runs on a varied offline fallback without this,
# but set these for the AI Support chat to be answered by the real Claude API)
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
